# Supabase (entorno de desarrollo) — ver docs/development.md#proyecto-de-supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Base de datos de la aplicación: pooler de Supabase en modo session, ver
# docs/database.md#conexión-a-supabase. No usar la conexión directa (IPv6) ni
# el modo transaction (sin soporte de prepared statements).
DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Cloudflare R2: almacenamiento de archivos (DXF originales, fotos y planos).
# Ver docs/secrets.md#cloudflare-r2. El endpoint es el de la cuenta, sin el
# bucket en la ruta.
CLOUDFLARE_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_BUCKET_NAME=loteos-files-dev
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
